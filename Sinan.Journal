<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trading Journal | 2026</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=Noto+Kufi+Arabic:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #050505;
            --glass: rgba(22, 22, 22, 0.7);
            --accent-orange: #ff6b00;
            --accent-blue: #00f2fe;
            --text-main: #f0f0f0;
            --text-muted: #888;
            --border: rgba(255, 255, 255, 0.08);
            --win: #00ffa3;
            --loss: #ff3e3e;
            --telegram: #0088cc;
            --whatsapp: #25d366;
        }

        body {
            font-family: 'Inter', 'Noto Kufi Arabic', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            margin: 0; padding: 20px; min-height: 100vh;
            background-image: radial-gradient(circle at 0% 0%, rgba(255, 107, 0, 0.04) 0%, transparent 40%);
        }

        .container { max-width: 1100px; margin: 0 auto; padding-bottom: 50px; }

        header { text-align: center; padding: 35px 0; border-bottom: 1px solid var(--border); margin-bottom: 30px; }
        header h1 { font-size: 2.2rem; font-weight: 800; margin: 0; color: #fff; }
        header h1 span { color: var(--accent-orange); }
        .slogan { color: var(--accent-blue); font-size: 1rem; margin-top: 12px; font-weight: 500; }

        .stats-bar { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-bottom: 30px; }
        .stat-card { background: var(--glass); backdrop-filter: blur(10px); padding: 20px; border-radius: 12px; border: 1px solid var(--border); text-align: center; }
        .stat-val { display: block; font-size: 1.4rem; font-weight: 800; color: #fff; }
        .stat-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; margin-top: 5px; }

        .premium-card { background: var(--glass); backdrop-filter: blur(15px); border-radius: 16px; border: 1px solid var(--border); padding: 30px; margin-bottom: 30px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; }
        .field { display: flex; flex-direction: column; gap: 8px; }
        .field label { font-size: 0.75rem; color: var(--text-muted); font-weight: 700; }

        input, select { background: rgba(255,255,255,0.03); border: 1px solid var(--border); color: white; padding: 12px; border-radius: 8px; outline: none; transition: 0.3s; }
        input:focus { border-color: var(--accent-orange); }

        .btn { cursor: pointer; border: none; border-radius: 8px; font-weight: 800; padding: 16px 30px; transition: 0.3s; }
        .btn-primary { background: linear-gradient(135deg, var(--accent-orange), #ff4500); color: white; width: 100%; margin-top: 20px; }
        
        .table-wrap { border-radius: 16px; overflow: hidden; border: 1px solid var(--border); background: var(--glass); margin-bottom: 30px; }
        table { width: 100%; border-collapse: collapse; min-width: 700px; }
        th { background: rgba(255,255,255,0.02); padding: 15px; text-align: right; color: var(--text-muted); font-size: 0.8rem; }
        td { padding: 15px; border-top: 1px solid var(--border); font-size: 0.9rem; }

        .delete-btn { color: var(--loss); cursor: pointer; background: transparent; border: none; font-size: 1.1rem; transition: 0.2s; }
        .delete-btn:hover { transform: scale(1.2); }

        .contact-footer { text-align: center; margin-top: 50px; padding: 30px; border-top: 1px solid var(--border); }
        .social-icons { display: flex; justify-content: center; gap: 25px; margin-top: 20px; }
        .social-link { text-decoration: none; font-size: 1.8rem; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border); transition: 0.4s; }
        .social-link.tg { color: var(--telegram); }
        .social-link.wa { color: var(--whatsapp); }

        #toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: var(--accent-blue); color: var(--bg-dark); padding: 12px 35px; border-radius: 50px; font-weight: 800; opacity: 0; transition: 0.5s; z-index: 1000; }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Sinan<span>.Journal</span></h1>
        <p class="slogan">لا عشوائية بعد اليوم.. سجل، حلل، انضبط</p>
    </header>

    <div class="stats-bar">
        <div class="stat-card"><span class="stat-val" id="stat-total">0</span><span class="stat-label">الصفقات</span></div>
        <div class="stat-card"><span class="stat-val" id="stat-pnl">0.00%</span><span class="stat-label">صافي النمو</span></div>
        <div class="stat-card"><span class="stat-val" id="stat-winrate">0%</span><span class="stat-label">النجاح</span></div>
        <div class="stat-card"><span class="stat-val" id="stat-avg-rrr" style="color: var(--accent-orange);">1:0</span><span class="stat-label">متوسط RRR</span></div>
    </div>
    
    <div class="premium-card">
        <div class="grid">
            <div class="field"><label>الزوج</label><input type="text" id="symbol" placeholder="BTC/USDT"></div>
            <div class="field"><label>النتيجة</label>
                <select id="result">
                    <option value="ربح ✅">ربح ✅</option>
                    <option value="خسارة ❌">خسارة ❌</option>
                    <option value="تعادل ➖">تعادل ➖</option>
                </select>
            </div>
            <div class="field"><label>المخاطرة (%)</label><input type="number" id="risk_pct" value="1" step="0.1"></div>
            <div class="field"><label>الربح (%)</label><input type="number" id="reward_pct" placeholder="3"></div>
            <div class="field"><label>الاستراتيجية</label><input type="text" id="strategy" placeholder="SMC, ICT, الخ.."></div>
        </div>
        <div class="field" style="margin-top:15px;"><label>ملاحظة</label><input type="text" id="note" placeholder="تفاصيل إضافية..."></div>
        <button class="btn btn-primary" onclick="addTrade()">إضافة الصفقة للسجل</button>
    </div>

    <div class="table-wrap" style="overflow-x: auto;">
        <table id="tradesTable">
            <thead>
                <tr>
                    <th>التاريخ</th>
                    <th>الزوج</th>
                    <th>النتيجة</th>
                    <th>المخاطرة</th>
                    <th>الربح</th>
                    <th>الاستراتيجية</th>
                    <th>RRR</th>
                    <th>حذف</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div style="display: flex; gap: 15px;">
        <button class="btn" style="background:var(--accent-blue); color:var(--bg-dark); flex:2" onclick="downloadCSV()">تحميل التقرير CSV</button>
        <button class="btn" style="background:transparent; border:1px solid var(--loss); color:var(--loss); flex:1" onclick="resetAll()">تصفير السجل</button>
    </div>

    <div class="contact-footer">
        <p style="color: var(--text-muted); font-size: 0.8rem;">لأي استفسار أو تطوير تواصل مع سنان</p>
        <div class="social-icons">
            <a href="https://t.me/sinanxch0" target="_blank" class="social-link tg"><i class="fab fa-telegram"></i></a>
            <a href="https://wa.me/447939893953" target="_blank" class="social-link wa"><i class="fab fa-whatsapp"></i></a>
        </div>
    </div>
</div>

<div id="toast">تم الحفظ 🔥</div>
<!-- رابط صوت خارجي يعمل عند الإضافة -->
<audio id="successSound" src="https://assets.mixkit.co/active_storage/sfx/2354/2354-preview.mp3" preload="auto"></audio>

<script>
    let trades = JSON.parse(localStorage.getItem('sinan_journal_v4')) || [];

    window.onload = renderAll;

    function addTrade() {
        const symbol = document.getElementById('symbol').value;
        const risk = parseFloat(document.getElementById('risk_pct').value) || 0;
        const rewardInput = parseFloat(document.getElementById('reward_pct').value) || 0;
        const strategy = document.getElementById('strategy').value || 'عام';
        const result = document.getElementById('result').value;
        const dateNow = new Date().toLocaleDateString('en-GB');

        if(!symbol) return showToast("يرجى إدخال اسم الزوج!");

        // تشغيل الصوت
        const sound = document.getElementById('successSound');
        sound.currentTime = 0;
        sound.play().catch(e => console.log("Sound error:", e));

        let currentRRR = risk > 0 ? (rewardInput / risk).toFixed(1) : "0";

        const trade = {
            id: Date.now(),
            date: dateNow,
            symbol: symbol.toUpperCase(),
            result: result,
            risk: risk,
            rewardValue: result.includes('ربح') ? rewardInput : (result.includes('خسارة') ? -risk : 0),
            displayReward: rewardInput,
            strategy: strategy,
            rrr: "1:" + currentRRR,
            note: document.getElementById('note').value || '-'
        };

        trades.push(trade);
        saveData();
        showToast("تمت إضافة الصفقة 🔥");
        ['symbol', 'reward_pct', 'strategy', 'note'].forEach(id => document.getElementById(id).value = '');
    }

    function deleteTrade(id) {
        if(confirm("هل تريد حذف هذه الصفقة؟")) {
            trades = trades.filter(t => t.id !== id);
            saveData();
            showToast("تم الحذف");
        }
    }

    function renderAll() {
        renderTable();
        updateStats();
    }

    function updateStats() {
        const total = trades.length;
        const wins = trades.filter(t => t.result.includes('ربح')).length;
        const winRate = total ? Math.round((wins / total) * 100) : 0;
        
        let totalPnL = 0;
        let sumRRR = 0;
        let profitableCount = 0;

        trades.forEach(t => {
            totalPnL += t.rewardValue;
            if (t.result.includes('ربح')) {
                sumRRR += parseFloat(t.rrr.split(':')[1]);
                profitableCount++;
            }
        });

        const avgRRR = profitableCount > 0 ? (sumRRR / profitableCount).toFixed(1) : "0";

        document.getElementById('stat-total').innerText = total;
        document.getElementById('stat-winrate').innerText = winRate + "%";
        
        const pnlEl = document.getElementById('stat-pnl');
        pnlEl.innerText = totalPnL.toFixed(2) + "%";
        pnlEl.style.color = totalPnL >= 0 ? 'var(--win)' : 'var(--loss)';
        
        document.getElementById('stat-avg-rrr').innerText = "1:" + avgRRR;
    }

    function renderTable() {
        const tbody = document.querySelector('#tradesTable tbody');
        tbody.innerHTML = '';
        trades.slice().reverse().forEach(t => {
            const isWin = t.result.includes('ربح');
            const color = isWin ? 'var(--win)' : (t.result.includes('خسارة') ? 'var(--loss)' : 'var(--text-muted)');
            
            tbody.innerHTML += `<tr>
                <td style="font-size: 0.75rem;">${t.date}</td>
                <td style="font-weight:800; color:var(--accent-blue)">${t.symbol}</td>
                <td style="color:${color}; font-weight:bold">${t.result}</td>
                <td>${t.risk}%</td>
                <td style="color:${isWin ? 'var(--win)' : 'inherit'}">${isWin ? t.displayReward + '%' : '0%'}</td>
                <td>${t.strategy}</td>
                <td><span class="rrr-badge">${t.rrr}</span></td>
                <td><button class="delete-btn" onclick="deleteTrade(${t.id})"><i class="fas fa-trash"></i></button></td>
            </tr>`;
        });
    }

    function saveData() { localStorage.setItem('sinan_journal_v4', JSON.stringify(trades)); renderAll(); }
    function showToast(msg) { const t = document.getElementById('toast'); t.innerText = msg; t.style.opacity = '1'; setTimeout(() => t.style.opacity = '0', 2000); }
    function resetAll() { if(confirm("سيتم مسح كافة البيانات، هل أنت متأكد؟")) { trades = []; saveData(); } }
    
    function downloadCSV() {
        const dateFileName = new Date().toLocaleDateString('en-GB').replace(/\//g, '-');
        let csv = "\uFEFFالتاريخ,الزوج,النتيجة,المخاطرة %,الربح %,الاستراتيجية,الـ RRR,الملاحظات\n";
        trades.forEach(t => csv += `${t.date},${t.symbol},${t.result},${t.risk},${t.result.includes('ربح') ? t.displayReward : 0},${t.strategy},${t.rrr},${t.note}\n`);
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = `Report_${dateFileName}.csv`;
        link.click();
    }
</script>

</body>
</html>
